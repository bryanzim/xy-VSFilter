<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\lib_$(VisualStudioVersion)\$(PlatformName)\</OutDir>
    <IntDir>$(SolutionDir)bin\obj_$(VisualStudioVersion)\$(Configuration)_$(PlatformName)\$(ProjectName)\</IntDir>
    <TargetName Condition="'$(Configuration)'=='Release'">$(ProjectName)R</TargetName>
    <TargetName Condition="'$(Configuration)'=='Debug'">$(ProjectName)D</TargetName>
    <TargetName Condition="'$(Configuration)'=='Release Unicode'">$(ProjectName)RU</TargetName>
    <TargetName Condition="'$(Configuration)'=='Debug Unicode'">$(ProjectName)DU</TargetName>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/w34706 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(PlatformToolset)'=='ClangCL'">/clang:-Wno-non-pod-varargs /clang:-Wno-c++11-narrowing %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(PlatformToolset)'=='ClangCL'">/clang:-Werror=parentheses /clang:-Wno-error=shift-op-parentheses /clang:-Werror=bitwise-op-parentheses /clang:-Werror=switch /clang:-Werror=unused-const-variable /clang:-Werror=braced-scalar-init /clang:-Werror=bool-conversion /clang:-Werror=constant-conversion /clang:-Werror=unused-but-set-variable /clang:-Werror=unused-value /clang:-Werror=unused-result /clang:-Werror=pointer-to-int-cast /clang:-Werror=int-to-pointer-cast /clang:-Werror=duplicate-decl-specifier /clang:-Werror=deprecated-register /clang:-Werror=self-assign /clang:-Werror=extern-initializer /clang:-Werror=ignored-reference-qualifiers /clang:-Werror=reserved-user-defined-literal /clang:-Werror=microsoft-enum-forward-reference /clang:-Werror=typename-missing /clang:-Werror=nonportable-include-path /clang:-Werror=reorder-ctor /clang:-Werror=unused-variable /clang:-Werror=missing-braces /clang:-Werror=unused-function /clang:-Werror=overloaded-virtual /clang:-Werror=unused-private-field /clang:-Werror=inconsistent-missing-override /clang:-Werror=missing-exception-spec /clang:-Werror=comment /clang:-Werror=pragma-pack /clang:-Werror=explicit-specialization-storage-class /clang:-Werror=microsoft-exception-spec /clang:-Werror=writable-strings /clang:-Werror=ignored-attributes /clang:-Werror=multichar /clang:-Werror=deprecated-declarations /clang:-Werror=microsoft-include /clang:-Werror=microsoft-extra-qualification /clang:-Werror=unused-local-typedef /clang:-Werror=extra-tokens /clang:-Werror=extern-c-compat /clang:-Werror=macro-redefined /clang:-Werror=microsoft-template /clang:-Werror=mismatched-new-delete /clang:-Werror=delete-non-abstract-non-virtual-dtor /clang:-Wshadow /clang:-Werror=implicit-fallthrough /clang:-Wformat /clang:-Werror=deprecated-copy /clang:-Werror=extra-semi /clang:-Wunreachable-code /clang:-Wmove /clang:-Wrange-loop-analysis /clang:-Wconditional-uninitialized /clang:-Wtautological-compare /clang:-Wfor-loop-analysis /clang:-Wheader-hygiene /clang:-Wmicrosoft-goto %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(ANALYZE)'=='true'">/wd4244 /wd4996 /wd6031 /wd6309 /wd6387 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Configuration)|$(VisualStudioVersion)'=='Release|12.0'">/Gw %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Configuration)|$(VisualStudioVersion)'=='Release|16.0'">/Gw /Qfast_transcendentals %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Configuration)|$(VisualStudioVersion)'=='Release|18.0' And '$(PlatformToolset)'!='ClangCL'">/Gw /Qfast_transcendentals %(AdditionalOptions)</AdditionalOptions>
      <EnableEnhancedInstructionSet>NotSet</EnableEnhancedInstructionSet>
      <EnableEnhancedInstructionSet Condition="'$(Platform)'=='Win32' And '$(VisualStudioVersion)'&gt;'10.0' And '$(PlatformToolset)'!='ClangCL'">NoExtensions</EnableEnhancedInstructionSet>
      <EnableEnhancedInstructionSet Condition="'$(Platform)'=='Win32' And '$(PlatformToolset)'=='ClangCL'">StreamingSIMDExtensions2</EnableEnhancedInstructionSet>
      <EnablePREfast Condition="'$(Platform)'=='Win32' And '$(ANALYZE)'=='true'">true</EnablePREfast>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntelJCCErratum Condition="'$(Configuration)|$(VisualStudioVersion)'=='Release|16.0'">true</IntelJCCErratum>
      <IntelJCCErratum Condition="'$(Configuration)|$(VisualStudioVersion)'=='Release|18.0' And '$(PlatformToolset)'!='ClangCL'">true</IntelJCCErratum>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>stdafx.h</PrecompiledHeaderFile>
      <PreprocessorDefinitions>WINVER=0x0601;_WIN32_WINNT=0x0601;PSAPI_VERSION=1;_WINDOWS;WINDOWS;_USE_MATH_DEFINES;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(PlatformToolset)'=='ClangCL'">BOOST_USE_WINDOWS_H;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)'=='Win32'">WIN32;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">_WIN64;WIN64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level4</WarningLevel>
    </ClCompile>
    <Lib>
      <TargetMachine Condition="'$(Platform)'=='Win32'">MachineX86</TargetMachine>
      <TargetMachine Condition="'$(Platform)'=='x64'">MachineX64</TargetMachine>
    </Lib>
    <Link>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <SubSystem>Windows</SubSystem>
      <TargetMachine Condition="'$(Platform)'=='Win32'">MachineX86</TargetMachine>
      <TargetMachine Condition="'$(Platform)'=='x64'">MachineX64</TargetMachine>
      <AdditionalOptions>/PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <ResourceCompile>
      <Culture>0x0409</Culture>
      <PreprocessorDefinitions Condition="'$(Platform)'=='Win32'">WIN32;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">_WIN64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' Or '$(Configuration)'=='Debug Unicode'">
    <ClCompile>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <DebugInformationFormat Condition="'$(Platform)'=='Win32'">EditAndContinue</DebugInformationFormat>
      <DebugInformationFormat Condition="'$(Platform)'=='x64'">ProgramDatabase</DebugInformationFormat>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release' Or '$(Configuration)'=='Release Unicode'">
    <ClCompile>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <OmitFramePointers Condition="'$(Platform)'=='Win32'">true</OmitFramePointers>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;_CRT_SECURE_NO_WARNINGS;_SCL_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <StringPooling>true</StringPooling>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <LargeAddressAware Condition="'$(Platform)'=='Win32'">true</LargeAddressAware>
      <MergeSections>.rdata=.text</MergeSections>
      <OptimizeReferences>true</OptimizeReferences>
      <SetChecksum>true</SetChecksum>
    </Link>
    <ResourceCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
</Project>